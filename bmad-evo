#!/bin/bash
# BMAD-EVO CLI wrapper
# Usage: bmad-evo [command] [options]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AUDITOR="$SCRIPT_DIR/agents/constraint_auditor.py"

show_help() {
    echo "BMAD-EVO v2.0 - 进化版多Agent开发框架"
    echo ""
    echo "Usage: bmad-evo [command] [options]"
    echo ""
    echo "Commands:"
    echo "  init [template]     初始化项目 (--template cron-job|api-service)"
    echo "  audit               运行约束审计"
    echo "  history             查看审计历史"
    echo "  check               检查阶段状态"
    echo "  help                显示帮助"
    echo ""
    echo "Examples:"
    echo "  bmad-evo init --template cron-job"
    echo "  bmad-evo audit --phase development --file main.py"
    echo "  cat code.py | bmad-evo audit --phase development"
    echo "  bmad-evo history --limit 5"
    echo "  bmad-evo check --phase development"
}

# Check if running from skill directory or project directory
if [ -f "$AUDITOR" ]; then
    # Running from skill directory
    PYTHON_CMD="python3"
elif [ -f ".bmad/project-charter.yaml" ]; then
    # Running from project directory, find skill
    SKILL_DIR="${BMAD_EVO_SKILL:-/root/.openclaw/skills/bmad-evo}"
    AUDITOR="$SKILL_DIR/agents/constraint_auditor.py"
    PYTHON_CMD="python3"
else
    echo "Error: Cannot find BMAD-EVO skill."
    echo "Please set BMAD_EVO_SKILL environment variable or run from skill directory."
    exit 1
fi

# Main command dispatcher
case "${1:-help}" in
    init)
        shift
        TEMPLATE="${2:-default}"
        echo "Initializing BMAD-EVO project with template: $TEMPLATE"
        
        mkdir -p .bmad/decisions .bmad/checkpoints .bmad/logs
        
        # Copy template constraints
        if [ -f "$SCRIPT_DIR/templates/constraints/$TEMPLATE.yaml" ]; then
            cp "$SCRIPT_DIR/templates/constraints/$TEMPLATE.yaml" .bmad/project-charter.yaml
            echo "✅ Created .bmad/project-charter.yaml from template: $TEMPLATE"
        else
            echo "⚠️  Template not found: $TEMPLATE, creating default"
            cat > .bmad/project-charter.yaml << 'EOF'
project:
  name: ""
  vision: ""

constraints:
  boundary_check:
    - check_null: true
  exception_handling:
    - check_io: true
  code_structure:
    - max_function_lines: 50
  readability:
    - require_docstrings: true
  security:
    - check_secrets: true
EOF
        fi
        
        echo "✅ Project initialized. Edit .bmad/project-charter.yaml to customize constraints."
        ;;
    
    audit)
        shift
        $PYTHON_CMD "$AUDITOR" audit "$@"
        exit $?
        ;;
    
    history)
        shift
        $PYTHON_CMD "$AUDITOR" history "$@"
        ;;
    
    check)
        shift
        $PYTHON_CMD "$AUDITOR" check "$@"
        exit $?
        ;;
    
    help|--help|-h)
        show_help
        ;;
    
    *)
        echo "Unknown command: $1"
        show_help
        exit 1
        ;;
esac
